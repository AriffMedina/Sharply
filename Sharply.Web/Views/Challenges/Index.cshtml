@model List<Sharply.Web.ViewModels.ChallengeViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Challenges";
}

<head><link href="~/css/challenges.css" rel="stylesheet" /></head>

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-logo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
            Sharply
        </div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Dashboard
                </a>
            </li>
            <li>
                <a asp-controller="Skills" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
                    Skills
                </a>
            </li>
            <li>
                <a asp-controller="Challenges" asp-action="Index" class="active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z" /><path d="M5 4H3v2a3 3 0 0 0 3 3M19 4h2v2a3 3 0 0 1-3 3" /></svg>
                    Challenges
                </a>
            </li>
            <li>
                <a asp-controller="Settings" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                    Settings
                </a>
            </li>
        </ul>
    </aside>

    <main class="main">
        <div class="section-header">
            <div>
                <div class="section-title-row">
                    <span class="section-title">Challenges</span>
                </div>
                <div class="section-subtitle">Complete missions by practicing your skills to earn XP.</div>
            </div>
        </div>

        <div class="challenges-list">
            @foreach (var challenge in Model)
            {
                var progressPercent = challenge.Target > 0 ? Math.Min(100, (int)Math.Round(challenge.Progress * 100.0 / challenge.Target)) : 0;

                <div class="card challenge-card @(challenge.IsCompleted ? "challenge-card--done" : "")">
                    <div class="challenge-top">
                        <div>
                            <div class="challenge-title">
                                @challenge.Title
                                @if (challenge.IsCompleted)
                                {
                                    <span class="challenge-done-badge">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" /></svg>
                                        Done
                                    </span>
                                }
                            </div>
                            <div class="challenge-desc">@challenge.Description</div>
                        </div>
                        <div class="challenge-xp-badge">+@challenge.XpReward XP</div>
                    </div>

                    <div class="challenge-progress-row">
                        <div class="challenge-progress-track">
                            <div class="challenge-progress-fill" style="width:@progressPercent%;"></div>
                        </div>
                        <div class="challenge-progress-label">@challenge.Progress/@challenge.Target</div>
                    </div>

                    <div class="challenge-period">Resets @(challenge.Period == "Daily" ? "daily" : "weekly, on Monday")</div>
                </div>
            }
        </div>
    </main>
</div>
