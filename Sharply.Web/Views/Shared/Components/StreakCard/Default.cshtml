@model Sharply.Web.ViewModels.StreakCardViewModel

<div class="card">
    <div class="streak-card-top">
        <div>
            <div class="streak-card-head">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c1 4-4 5-4 9a4 4 0 0 0 8 0c1.5 1 2 3 2 4.5A6.5 6.5 0 0 1 5 15.5C5 9 12 7 12 2z" /></svg>
                Your Streak
            </div>
            <div class="streak-big-number">@Model.StreakDays day@(Model.StreakDays == 1 ? "" : "s")</div>
            <div class="streak-best">Best: @Model.BestStreakDays day@(Model.BestStreakDays == 1 ? "" : "s")</div>
        </div>
        <div class="streak-card-mascot-wrap">
            <partial name="_OwlMascot" />
        </div>
    </div>
    <div class="streak-week">
        @foreach (var day in Model.WeekActivity)
        {
            <div class="streak-day">
                <div class="streak-day-dot @(day.Practiced ? "practiced" : "") @(day.IsToday ? "today" : "")">
                    @if (day.Practiced)
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" /></svg>
                    }
                </div>
                <div class="streak-day-label">@day.Label</div>
            </div>
        }
    </div>
</div>
