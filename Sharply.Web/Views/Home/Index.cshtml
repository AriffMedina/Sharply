@using System.Linq
@model Sharply.Web.ViewModels.DashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
}

@functions {
    int HighPriorityCount()
    {
        int count = 0;
        foreach (var s in Model.Skills)
            if (s.Priority == "High") count++;
        return count;
    }
}

<div class="app-shell">

    @await Component.InvokeAsync("AppSidebar", new { active = "Dashboard" })

    <main class="main">

        @await Component.InvokeAsync("AppTopbar")

        <div class="dashboard-greeting">
            <h1>Welcome back, @Model.UserName.Split(' ')[0]! 👋</h1>
            <p>Keep sharpening your skills every day.</p>
        </div>

        <div class="dashboard-grid">
        <div class="dashboard-primary">

        <div class="stats-row">
            <div class="card stat-card stat-card--green">
                <div class="stat-head">
                    <span class="stat-label">AVG RETENTION</span>
                    <span class="stat-icon-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 17l6-6 4 4 8-8" /><path d="M17 7h4v4" /></svg>
                    </span>
                </div>
                <div class="stat-value">@Model.AvgRetention.ToString("0.0")%</div>
                <div class="stat-caption">@(Model.AvgRetention >= 80 ? "Amazing! You're retaining everything." : Model.AvgRetention >= 50 ? "Solid — a few skills could use a refresher." : "Some skills need attention soon.")</div>
                <partial name="_OwlMascot" />
            </div>

            <div class="card stat-card stat-card--violet">
                <div class="stat-head">
                    <span class="stat-label">WEEKLY ACTIVITY</span>
                </div>
                <div class="stat-headline">@Model.WeeklyInsightMessage</div>
                <div class="chart-wrap">
                    <svg viewBox="0 0 220 70" width="100%" height="64" preserveAspectRatio="none">
                        <polyline points="@Model.WeeklyActivityPoints" fill="none" stroke="var(--primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <div class="chart-axis"><span>@Model.WeeklyActivityStartLabel</span><span>@Model.WeeklyActivityEndLabel</span></div>
                </div>
            </div>

            <div class="card stat-card stat-card--amber">
                <div class="stat-head">
                    <span class="stat-label">NEXT GOAL</span>
                    <span class="stat-icon-badge" style="background:var(--amber-soft);color:var(--amber);">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="9" width="18" height="12" rx="1.5" /><path d="M3 9h18M12 9v12M12 9c-2-3-6-3-6 0 0 1.5 1.5 2 3 2h3zM12 9c2-3 6-3 6 0 0 1.5-1.5 2-3 2h-3z" /></svg>
                    </span>
                </div>
                <div class="stat-headline">@Model.NextGoalLabel</div>
                <div class="goal-progress-track">
                    <div class="goal-progress-fill" style="width:@(Model.NextGoalTarget > 0 ? (Model.NextGoalProgress * 100 / Model.NextGoalTarget) : 0)%;"></div>
                </div>
                <div class="goal-progress-label">@Model.NextGoalProgress / @Model.NextGoalTarget days</div>
            </div>
        </div>

        <div class="section-header">
            <div>
                <div class="section-title-row">
                    <span class="section-title">Your Skill Forge</span>
                    <span class="section-badge">@Model.Skills.Count Total</span>
                </div>
                <div class="section-subtitle">Reviewing @HighPriorityCount() High Priority skills today.</div>
            </div>
            <div class="section-actions">
                <a class="btn-primary" asp-controller="Skills" asp-action="Create">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14" /></svg>
                    Add Skill
                </a>
            </div>
        </div>

        @if (Model.Skills.Count == 0)
        {
            <div class="card skills-empty">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
                <p>You have no skills logged yet.</p>
                <a class="btn-primary" asp-controller="Skills" asp-action="Create">Add my first skill</a>
            </div>
        }
        else
        {
        <div class="skills-grid" id="skillsGrid">
            <div class="card skills-empty" id="skillsSearchEmpty" style="display:none;">
                <p>No skills match your search.</p>
            </div>
            @foreach (var skill in Model.Skills)
            {
                <partial name="_SkillCard" model="skill" />
            }
        </div>
        }

        @if (!string.IsNullOrEmpty(Model.GroupName) && Model.GroupSkills.Count > 0)
        {
            <div class="section-header">
                <div>
                    <div class="section-title-row">
                        <span class="section-title">@Model.GroupName</span>
                        <span class="section-badge">@Model.GroupSkills.Count skill@(Model.GroupSkills.Count == 1 ? "" : "s")</span>
                    </div>
                </div>
                <div class="section-actions">
                    <a class="btn-ghost" asp-controller="Community" asp-action="Index">
                        View group
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6" /></svg>
                    </a>
                </div>
            </div>

            <div class="skills-grid">
                @foreach (var skill in Model.GroupSkills)
                {
                    <partial name="_SkillCard" model="skill" />
                }
            </div>
        }

        <div class="card tip-banner">
            <div class="tip-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
            </div>
            <div class="tip-body">
                <div class="tip-title">Sharply Tip: Spaced Repetition</div>
                <div class="tip-text">Focusing on your <span class="highlight">Beginner</span> skills for just 10 minutes a day can improve long-term retention by up to 40%. Consistency beats intensity.</div>
            </div>
        </div>

        <div class="card email-card">
            <div class="email-copy">
                <div class="email-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
                    Test email notifications (MailKit)
                </div>
                <div class="email-text">Sends the same "skill at risk" alert triggered by the DecayWorker, to confirm that SMTP sending with MailKit works end-to-end.</div>
            </div>

            <form class="email-form" method="post" asp-controller="Home" asp-action="SendTestEmail">
                @Html.AntiForgeryToken()
                <input type="email" name="testEmail" placeholder="you@example.com" required value="@Model.LastTestEmail" />
                <button class="btn-primary" type="submit">Send test email</button>

                @if (!string.IsNullOrEmpty(Model.EmailStatusMessage))
                {
                    <div class="email-status @(Model.EmailSendSuccess ? "ok" : "error")">@Model.EmailStatusMessage</div>
                }
            </form>
        </div>

        </div>

        <div class="dashboard-secondary">
            <div class="card promo-card">
                <div class="promo-eyebrow">GROWTH TRACKING</div>
                <div class="promo-title">Historical Insights</div>
                <div class="promo-text">Analyze your learning patterns over the last 90 days.</div>
                <a class="promo-btn" asp-controller="Home" asp-action="History">
                    View History
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6" /></svg>
                </a>
                <svg class="promo-illustration" viewBox="0 0 150 100" fill="none">
                    <polygon points="0,100 35,42 55,66 82,26 150,100" fill="rgba(255,255,255,0.18)" />
                    <polygon points="82,26 100,58 64,58" fill="#ffffff" opacity="0.95" />
                    <line x1="82" y1="26" x2="82" y2="8" stroke="#ffffff" stroke-width="2" />
                    <polygon points="82,8 82,18 94,13" fill="#fbbf24" />
                </svg>
            </div>

            @await Component.InvokeAsync("StreakCard")

            <div class="card">
                <div class="achievements-head">
                    <span class="section-title">Achievements</span>
                    <span class="achievements-count">@(Model.Achievements.Count(a => a.Unlocked)) / @Model.Achievements.Count unlocked</span>
                </div>
                <div class="achievements-grid">
                    @foreach (var achievement in Model.Achievements)
                    {
                        <div class="achievement-badge achievement-badge--@achievement.Icon" title="@achievement.Description">
                            <div class="achievement-icon-wrap">
                                <div class="achievement-icon">
                                    @if (achievement.Icon == "shield")
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                                    }
                                    else if (achievement.Icon == "heart")
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-6.7-4.35-9.3-8.1C1 10.1 1.8 6.6 4.9 5.3 7 4.4 9.2 5.1 12 7.8c2.8-2.7 5-3.4 7.1-2.5 3.1 1.3 3.9 4.8 2.2 7.6C18.7 16.65 12 21 12 21z" /></svg>
                                    }
                                    else
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 9.5 8.5 3 9l5 4.5L6.5 20 12 16.5 17.5 20 16 13.5l5-4.5-6.5-.5z" /></svg>
                                    }
                                </div>
                                <div class="achievement-status @(achievement.Unlocked ? "unlocked" : "locked")">
                                    @if (achievement.Unlocked)
                                    {
                                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M20 6 9 17l-5-5" /></svg>
                                    }
                                    else
                                    {
                                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                                    }
                                </div>
                            </div>
                            <div class="achievement-title">@achievement.Title</div>
                        </div>
                    }
                </div>
            </div>

            <div class="card quote-card">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-6.7-4.35-9.3-8.1C1 10.1 1.8 6.6 4.9 5.3 7 4.4 9.2 5.1 12 7.8c2.8-2.7 5-3.4 7.1-2.5 3.1 1.3 3.9 4.8 2.2 7.6C18.7 16.65 12 21 12 21z" /></svg>
                <span>Every minute you practice, you're becoming better. ✨</span>
            </div>
        </div>
        </div>

    </main>
</div>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('skillSearchInput');
            var grid = document.getElementById('skillsGrid');
            if (!searchInput || !grid) return;

            var cards = Array.prototype.slice.call(grid.querySelectorAll('.skill-card'));
            var emptyState = document.getElementById('skillsSearchEmpty');

            searchInput.addEventListener('input', function () {
                var query = searchInput.value.trim().toLowerCase();
                var visibleCount = 0;

                cards.forEach(function (card) {
                    var matches = card.dataset.skillName.indexOf(query) !== -1;
                    card.style.display = matches ? '' : 'none';
                    if (matches) visibleCount++;
                });

                emptyState.style.display = visibleCount === 0 ? '' : 'none';
            });
        })();
    </script>
}
