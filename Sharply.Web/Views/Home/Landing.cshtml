@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sharply — Don't let your skills rust";
    ViewData["BodyClass"] = "auth-body--flat";
}

<head>
    <link href="~/css/landing.css" rel="stylesheet" />
</head>

<div class="landing-shell">

    <div class="landing-hero-viewport">
    <div class="landing-header">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
        Sharply
    </div>

    <div class="landing-hero">
        <div class="landing-visual">
            <div class="landing-visual-panel">
                <partial name="_OwlMascot" />
            </div>
        </div>

        <div class="landing-copy">
            <h1 class="landing-title">Don't let your skills rust</h1>
            <p class="landing-subtitle">
                Sharply follows the Ebbinghaus forgetting curve to tell you exactly what to review and when,
                before it slips out of memory.
            </p>
            <div class="landing-ctas">
                <a class="landing-cta-primary" asp-controller="Account" asp-action="Register">Create account</a>
                <a class="landing-cta-secondary" asp-controller="Account" asp-action="Login">I already have an account</a>
            </div>
        </div>
    </div>

    <div class="landing-scroll-cue" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
    </div>
    </div>

    <div class="landing-progress-rail" id="landingProgressRail" aria-hidden="true">
        <div class="landing-progress-fill" id="landingProgressFill"></div>
    </div>

    <div class="landing-about">

        <section class="landing-about-section">
            <div class="landing-about-label">THE PROBLEM</div>
            <h2 class="landing-about-title">You learn a lot. But forgetting is silent.</h2>
            <p class="landing-about-text">
                As a developer or professional today you juggle dozens of technologies. You learn React, then spend a month buried in databases, and when you get back to that React project three weeks later — something's gone.
                Not everything, but enough to slow you down. Enough to feel rusty.
            </p>
            <p class="landing-about-text">
                The problem isn't that you didn't learn it well. It's that no one reminded you to review it. Skills decay silently, and most tools only help you learn new things — not protect what you've already built.
            </p>
        </section>

        <section class="landing-about-section">
            <div class="landing-about-label">THE SCIENCE</div>
            <h2 class="landing-about-title">Based on the Ebbinghaus forgetting curve</h2>
            <p class="landing-about-text">
                In 1885, psychologist Hermann Ebbinghaus discovered that memory decays in a predictable pattern after learning something. Without reinforcement, you forget about 50% of new information within a day, and up to 90% within a week.
            </p>
            <p class="landing-about-text">
                Sharply uses this model — adapted to technical skills — to calculate a retention score for every skill you track. The longer you go without practicing, the lower your retention drops. Log a practice session and the curve resets. The goal is simple: keep your skills in the green.
            </p>
            <div class="landing-about-highlights">
                <div class="landing-about-highlight">
                    <div class="highlight-icon sharp">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
                    </div>
                    <div>
                        <div class="highlight-label">Sharp</div>
                        <div class="highlight-desc">Retention above 80% — practiced recently and solid.</div>
                    </div>
                </div>
                <div class="landing-about-highlight">
                    <div class="highlight-icon intermediate">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 17l6-6 4 4 8-8" /></svg>
                    </div>
                    <div>
                        <div class="highlight-label">Intermediate</div>
                        <div class="highlight-desc">Retention between 50–80% — worth reviewing soon.</div>
                    </div>
                </div>
                <div class="landing-about-highlight">
                    <div class="highlight-icon rusty">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01" /><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /></svg>
                    </div>
                    <div>
                        <div class="highlight-label">Rusty</div>
                        <div class="highlight-desc">Retention below 50% — needs attention before more is lost.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-about-section">
            <div class="landing-about-label">HOW IT HELPS</div>
            <h2 class="landing-about-title">A dashboard that watches your back</h2>
            <div class="landing-about-features">
                <div class="landing-about-feature">
                    <div class="feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
                    </div>
                    <div>
                        <div class="feature-title">Decay tracking</div>
                        <div class="feature-desc">Every skill you add is monitored in real time. Sharply calculates how many days have passed since your last practice and adjusts your retention score automatically.</div>
                    </div>
                </div>
                <div class="landing-about-feature">
                    <div class="feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 6-10 7L2 6" /></svg>
                    </div>
                    <div>
                        <div class="feature-title">Proactive alerts</div>
                        <div class="feature-desc">You shouldn't have to open the app to find out you're forgetting something. Sharply sends you an email when a skill is at risk — before the knowledge is lost.</div>
                    </div>
                </div>
                <div class="landing-about-feature">
                    <div class="feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z" /></svg>
                    </div>
                    <div>
                        <div class="feature-title">Streaks and consistency</div>
                        <div class="feature-desc">Sharply rewards consistency over intensity. A regular 10-minute review beats a 3-hour session once a month. Your streak keeps you accountable.</div>
                    </div>
                </div>
                <div class="landing-about-feature">
                    <div class="feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" /></svg>
                    </div>
                    <div>
                        <div class="feature-title">Priority and focus</div>
                        <div class="feature-desc">Mark your skills as High, Medium, or Low priority. Sharply surfaces the most critical ones first so you always know where to focus your limited time.</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-about-section landing-about-cta">
            <h2 class="landing-about-title">Your knowledge is an asset. Protect it.</h2>
            <p class="landing-about-text">Sharply is built for people who take their craft seriously — developers, designers, and anyone building expertise over time who can't afford to lose it.</p>
            <a class="landing-cta-primary landing-about-cta-btn" asp-controller="Account" asp-action="Register">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14" /></svg>
                Create free account
            </a>
        </section>

    </div>

</div>

@section Scripts {
    <script>
        (function () {
            var about = document.querySelector('.landing-about');
            var rail = document.getElementById('landingProgressRail');
            var fill = document.getElementById('landingProgressFill');
            if (!about || !rail || !fill) return;

            function update() {
                var rect = about.getBoundingClientRect();
                var viewportH = window.innerHeight;
                var total = rect.height - viewportH;
                var scrolled = -rect.top;
                var ratio = total > 0 ? Math.min(1, Math.max(0, scrolled / total)) : (rect.top < viewportH ? 1 : 0);
                var inRange = rect.top < viewportH && rect.bottom > 0;

                rail.classList.toggle('visible', inRange);
                fill.style.height = (ratio * 100) + '%';
            }

            update();
            window.addEventListener('scroll', update, { passive: true });
            window.addEventListener('resize', update);
        })();
    </script>
}
