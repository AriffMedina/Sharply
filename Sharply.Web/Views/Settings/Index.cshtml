@model Sharply.Web.ViewModels.SettingsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Settings";
}

<head>
    <link href="~/css/skill-form.css" rel="stylesheet" />
    <link href="~/css/settings.css" rel="stylesheet" />
</head>

<div class="app-shell">
    @await Component.InvokeAsync("AppSidebar", new { active = "Settings" })

    <main class="main">
        @await Component.InvokeAsync("AppTopbar", new { showSearch = false })

        <div class="section-header">
            <div class="section-title-row settings-header-row">
                <div class="settings-header-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h0a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h0a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                </div>
                <div>
                    <span class="section-title">Settings</span>
                    <div class="section-subtitle">Manage your profile and decay notification preferences.</div>
                </div>
            </div>
        </div>

        @if (TempData["SettingsSaved"] != null)
        {
            <div class="skill-toast skill-toast--ok">Settings saved.</div>
        }

        <div class="card settings-card">
            <div class="settings-card-title">
                <div class="settings-card-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" /></svg>
                </div>
                <span>Profile &amp; Notifications</span>
            </div>

            <form method="post" asp-controller="Settings" asp-action="Index">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="auth-error-summary">Please check the fields below.</div>
                }

                <div class="settings-row">
                    <div class="field-group">
                        <label class="field-label" asp-for="Name">Name</label>
                        <input class="field-input" asp-for="Name" autocomplete="off" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>

                    <div class="field-group">
                        <label class="field-label" asp-for="Email">Email</label>
                        <input class="field-input" asp-for="Email" type="email" autocomplete="off" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                </div>

                <div class="settings-row settings-row--align-start">
                    <div class="settings-notif-box">
                        <div class="form-section-title">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                            Decay Notifications
                        </div>
                        <div class="field-group settings-checkbox-row">
                            <label>
                                <input type="checkbox" asp-for="DecayEmailEnabled" />
                                Email me when a skill is at risk of decaying
                            </label>
                        </div>
                    </div>

                    <div class="field-group">
                        <label class="field-label" asp-for="DecayRetentionThreshold">Alert Threshold (retention, 0–1)</label>
                        <input class="field-input settings-threshold-input" asp-for="DecayRetentionThreshold" type="number" step="0.05" min="0" max="1" />
                        <div class="field-hint">A skill is flagged "at risk" once its retention drops below this value.</div>
                        <span asp-validation-for="DecayRetentionThreshold" class="field-error"></span>
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" asp-for="DecayStrategy">Decay Strategy</label>
                    <select class="field-input" asp-for="DecayStrategy">
                        <option value="Ebbinghaus">Ebbinghaus (exponential)</option>
                        <option value="Linear">Linear</option>
                    </select>
                    <div class="field-hint">Ebbinghaus mimics natural forgetting; Linear decays at a constant daily rate.</div>
                </div>

                <button class="btn-primary settings-save-btn" type="submit">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8M7 3v5h8" /></svg>
                    Save Changes
                </button>
            </form>
        </div>

        <div class="card settings-card settings-danger-zone">
            <div class="form-section-title settings-danger-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 6v6c0 5 3.5 8.5 9 10 5.5-1.5 9-5 9-10V6l-9-4z" /></svg>
                Danger Zone
            </div>
            <p class="field-hint settings-danger-text">Deleting your account permanently removes all your skills and practice history. This can't be undone.</p>
            <form method="post" asp-controller="Settings" asp-action="DeleteAccount"
                  onsubmit="return confirm('Are you sure you want to permanently delete your account? This cannot be undone.')">
                @Html.AntiForgeryToken()
                <button class="settings-delete-btn" type="submit">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6" /></svg>
                    Delete My Account
                </button>
            </form>
        </div>
    </main>
</div>
